<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineKiosk_UI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineKiosk_UI.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <h1>Online Kiosk</h1>

            <a class="pill-button" asp-page="/Index" >
                Back to catalog
            </a>

        <div class="topbar-actions">
            <a class="pill-button" asp-page="/Account/Login">
                Sign in
            </a>

            <a class="pill-button cart-button" asp-page="/Cart">
                <span>Your cart</span>
                <span class="cart-icon">🛒</span>
            </a>
        </div>
    </header>

    <div class="kiosk-page">
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OnlineKiosk_UI - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>